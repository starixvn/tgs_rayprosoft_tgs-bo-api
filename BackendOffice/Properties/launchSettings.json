{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "BackOffice": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "BackOffice-Api(local)",
        "NODE_IP": "otel.rpgp.cc"
      },
      "applicationUrl": "http://localhost:5007;http://localhost:5006"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Docker",
        "OTEL_SERVICE_NAME": "BackOffice-Api(local)",
        "NODE_IP": "otel.rpgp.cc"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  }
}